  "schemaFiles": [
    "schemas/scene-texts-fragment.json",
    "schemas/agent-config.json",
    "schemas/agent-playbook-fragment.json"
  ],
  "agent": {
    "entryEvent": "event.start",
    "choiceEvent": "ygg.choice_selected",
    "summaryEvent": "agent.summary",
    "endingPrefix": "[ENDING",
    "metaKey": "summary",
    "rejectionPrefixes": [
      "[REJECTED:ACTION]",
      "[REJECTED:PAYLOAD]",
      "[BLOCKED:TODO]"
    ],
    "replayPrefix": "[REPLAY",
    "defaultPayload": "0"
  },
  "inboxRoutes": {
    "externalIdField": "external_id",
    "payloadField": "payload",
    "extMarker": "@ext=",
    "add": {
      "action": "requirement.add",
      "fields": [
        "title",
        "description",
        "external_id",
        "depends_on"
      ],
      "write": {
        "flag": "requirement",
        "shape": "named"
      }
    },
    "amend": {
      "action": "requirement.amend",
      "fields": [
        "req",
        "title",
        "description",
        "depends"
      ],
      "write": {
        "flag": "amend",
        "shape": "payload"
      }
    },
    "split": {
      "action": "requirement.split",
      "fields": [
        "req",
        "children"
      ],
      "write": {
        "flag": "split",
        "shape": "payload"
      }
    },
    "merge": {
      "action": "requirement.merge",
      "fields": [
        "reqs",
        "title",
        "description"
      ],
      "write": {
        "flag": "merge",
        "shape": "payload"
      }
    },
    "conflict": {
      "action": "requirement.conflict",
      "fields": [
        "reqs",
        "note"
      ],
      "write": {
        "flag": "conflict",
        "shape": "payload"
      }
    },
    "resolve": {
      "action": "requirement.resolve",
      "fields": [
        "reqs",
        "mode",
        "note"
      ],
      "write": {
        "flag": "resolve",
        "shape": "payload"
      }
    },
    "proposal": {
      "action": "proposal.submit",
      "fields": [
        "req",
        "rev",
        "stage",
        "summary",
        "artifacts",
        "changes",
        "external_id"
      ],
      "write": {
        "flag": "proposal",
        "shape": "payload"
      },
      "actor": true,
      "actor_session": true
    },
    "tool_result": {
      "action": "tool.result",
      "fields": [
        "call_id",
        "tool_id",
        "status",
        "code",
        "output",
        "external_id"
      ],
      "write": {
        "flag": "tool-result",
        "shape": "payload"
      }
    }
  },
  "tools": {
    "git.head_short": {
      "kind": "cli",
      "program": "git",
      "args": [
        "rev-parse",
        "--short",
        "HEAD"
      ],
      "timeoutMs": 5000,
      "inlineWaitMs": 2000,
      "maxOutputBytes": 256,
      "readOnly": true,
      "resultEvent": "tool.result"
    },
    "git.status": {
      "kind": "cli",
      "program": "git",
      "args": [
        "status",
        "--porcelain"
      ],
      "timeoutMs": 5000,
      "inlineWaitMs": 2000,
      "maxOutputBytes": 1024,
      "readOnly": true,
      "resultEvent": "tool.result"
    },
    "git.worktree_claim": {
      "kind": "cli",
      "program": "egg",
      "args": [
        "--builtin-tool",
        "worktree-claim",
        "--lane",
        "{{lane}}",
        "--req",
        "{{req}}",
        "--branch",
        "{{branch}}"
      ],
      "timeoutMs": 15000,
      "inlineWaitMs": 5000,
      "maxOutputBytes": 1024,
      "readOnly": false,
      "resultEvent": "tool.result"
    },
    "git.worktree_release": {
      "kind": "cli",
      "program": "egg",
      "args": [
        "--builtin-tool",
        "worktree-release",
        "--lane",
        "{{lane}}"
      ],
      "timeoutMs": 15000,
      "inlineWaitMs": 5000,
      "maxOutputBytes": 512,
      "readOnly": false,
      "resultEvent": "tool.result"
    },
    "git.lane_probe": {
      "kind": "cli",
      "program": "egg",
      "args": [
        "--builtin-tool",
        "lane-probe",
        "--lane",
        "{{lane}}",
        "--base",
        "{{base}}",
        "--branch",
        "{{branch}}"
      ],
      "timeoutMs": 10000,
      "inlineWaitMs": 3000,
      "maxOutputBytes": 2048,
      "readOnly": true,
      "resultEvent": "tool.result"
    },
    "fs.artifact_probe": {
      "kind": "cli",
      "program": "egg",
      "args": [
        "--builtin-tool",
        "artifact-probe",
        "--path",
        "{{path}}"
      ],
      "timeoutMs": 5000,
      "inlineWaitMs": 2000,
      "maxOutputBytes": 512,
      "readOnly": true,
      "resultEvent": "tool.result"
    },
    "gate.verify_suite": {
      "kind": "cli",
      "program": "egg",
      "args": [
        "--builtin-tool",
        "verify-suite",
        "--mode",
        "{{mode}}"
      ],
      "timeoutMs": 600000,
      "inlineWaitMs": 0,
      "maxOutputBytes": 4096,
      "readOnly": true,
      "resultEvent": "tool.result"
    }
  },
  "code": {
    "entry": "mod.lua",
    "modules": [
      "src/core/util.lua",
      "src/core/config.lua",
      "src/domain/requirements.lua",
      "src/domain/lanes.lua",
      "src/domain/proposals.lua",
      "src/domain/gates.lua",
      "src/core/hooks.lua",
      "src/domain/executor.lua",
      "src/view/guide.lua",
      "src/view/menus.lua",
      "src/view/render.lua",
      "src/domain/wire.lua",
      "src/runtime/tools.lua",
      "src/runtime/flow.lua",
      "src/handlers/intake/actions.lua",
      "src/handlers/operate/lanes.lua",
      "src/handlers/requirements/proposals.lua",
      "src/handlers/operate/review.lua",
      "src/handlers/requirements/requirement_ops.lua",
      "src/handlers/requirements/gate_actions.lua",
      "src/handlers/system/config.lua",
      "src/handlers/system/views.lua",
      "src/handlers/operate/choice.lua",
      "src/handlers/intake/lifecycle.lua"
    ]
  }
}
