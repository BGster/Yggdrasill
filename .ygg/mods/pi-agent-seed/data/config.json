{
  "play": {
    "mode": "guide"
  },
  "drive": {
    "maxSteps": 200,
    "stallLimit": 20,
    "stepsPerRequirement": 20
  },
  "evolution": {
    "mode": "suggest",
    "allow_paths": [
      "prompts",
      "beats"
    ],
    "max_per_run": 1
  },
  "autosave": true,
  "hot_reload": true,
  "gates": {
    "require_all_green": true
  },
  "harness": {
    "adapter": "auto"
  },
  "settlement": {
    "requireEvents": true,
    "requireNoFailedSteps": true,
    "requireEnding": true,
    "requireInboxConsumed": true
  },
  "allowedTools": [
    "git.head_short",
    "git.status",
    "git.worktree_claim",
    "git.worktree_release",
    "git.lane_probe",
    "fs.artifact_probe",
    "gate.verify_suite",
    "harness.archive_sessions"
  ]
}
