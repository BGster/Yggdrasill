; Yggdrasill Godot 客户端——gdext 绑定描述。
;
; 产物由 `cd clients/godot/rust && cargo build` 生成
; （target/debug/libygg_godot.dylib），拷入本目录并改名
; libygg_godot.macos.template_debug.dylib（见 clients/godot/README.md）。
; 四种构建组合目前都指向 debug 模板产物：本切片只做本地开发构建。
[configuration]

entry_symbol = "gdext_rust_init"
compatibility_minimum = "4.2"

[libraries]

macos.debug = "res://bin/libygg_godot.macos.template_debug.dylib"
macos.release = "res://bin/libygg_godot.macos.template_debug.dylib"
macos.template_debug = "res://bin/libygg_godot.macos.template_debug.dylib"
macos.template_release = "res://bin/libygg_godot.macos.template_debug.dylib"
