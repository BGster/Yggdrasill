{
  "compilerOptions": {
    "target": "ES2022",
    "lib": ["ES2022", "DOM", "DOM.Iterable"],
    "module": "ESNext",
    "moduleResolution": "bundler",
    "jsx": "react-jsx",
    "strict": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noFallthroughCasesInSwitch": true,
    "resolveJsonModule": true,
    "isolatedModules": true,
    "skipLibCheck": true,
    "noEmit": true,
    "useDefineForClassFields": true,
    "baseUrl": ".",
    "paths": {
      "@ygg/pipeline/sse": ["../pipeline/src/sse.ts"]
    },
    "types": ["vite/client"]
  },
  "include": [
    "src",
    "vite.config.ts",
    "vite.dev-endpoint.ts",
    "vite.plugin.mods.ts",
    "vite.plugin.generate.ts",
    "vite.plugin.revise.ts"
  ]
}
