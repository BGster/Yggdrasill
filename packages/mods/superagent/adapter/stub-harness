#!/bin/sh
# superagent stub harness —— 确定性 echo agent（P4 适配器参考件）。
#
# 用途：全链路自测与验收冒烟的「不绑死一家的 harness」替身——只读、零副作用、
# 同输入同输出（重放断言的根据）。真实 harness（multica / herdr / 任何 CLI agent）
# 由 adapter/superagent-convert 的同形调用替换本脚本即可接入。
#
# 接口（harness CLI 语法，参考面）：
#   stub-harness --text <正文> [--agent <id>] [--session <会话>]
# stdout：单行回执 `ECHO[<agent>]: <text>`
# 退出码：0（正常）；用法错 = 2
set -eu

text=""
agent="unknown"
session=""

while [ "$#" -gt 0 ]; do
    case "$1" in
        --text)
            text="${2-}"
            shift 2
            ;;
        --agent)
            agent="${2-}"
            shift 2
            ;;
        --session)
            session="${2-}"
            shift 2
            ;;
        *)
            echo "stub-harness: 未知参数 $1" >&2
            exit 2
            ;;
    esac
done

if [ -z "$text" ]; then
    echo "stub-harness: --text 必填" >&2
    exit 2
fi

# 确定性回执：文本原样回显 + 固定前缀；session 不进输出（不透明字段，无语义）。
printf 'ECHO[%s]: %s\n' "$agent" "$text"
