{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yggdrasill.dev/schemas/v1/superagent-envelope.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["v", "fields", "kinds", "outbound", "notes"],
  "properties": {
    "v": { "type": "integer", "const": 1 },
    "fields": {
      "type": "object",
      "additionalProperties": { "type": "string", "minLength": 1 },
      "minProperties": 7,
      "propertyNames": {
        "pattern": "^[a-zA-Z][a-zA-Z0-9_]*$"
      }
    },
    "kinds": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["kind", "means", "wire"],
        "properties": {
          "kind": {
            "type": "string",
            "enum": ["agent.chat", "agent.action", "quest.delivery", "quest.custom", "harness.ping", "agent.error"]
          },
          "means": { "type": "string", "minLength": 1 },
          "wire": {
            "type": "array",
            "minItems": 1,
            "items": {
              "type": "string",
              "enum": ["externalId", "agent", "session", "text", "refs"]
            }
          },
          "actor": { "type": "boolean" },
          "actor_session": { "type": "boolean" }
        }
      }
    },
    "outbound": {
      "type": "object",
      "additionalProperties": false,
      "required": ["tool", "resultEvent", "resultWire"],
      "properties": {
        "tool": { "type": "string", "const": "superagent.agent_call" },
        "resultEvent": { "type": "string", "const": "harness.replied" },
        "resultWire": {
          "type": "string",
          "const": "<call_id>|<tool_id>|<status>|<code>|<output>|<external_id>"
        }
      }
    },
    "notes": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    }
  }
}
