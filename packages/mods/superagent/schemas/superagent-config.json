{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yggdrasill.dev/schemas/v1/superagent-config.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["drive", "settlement", "harness", "allowedTools", "game"],
  "properties": {
    "drive": {
      "type": "object",
      "additionalProperties": false,
      "required": ["maxSteps", "stallLimit", "stepsPerRequirement"],
      "properties": {
        "maxSteps": { "type": "integer", "minimum": 1 },
        "stallLimit": { "type": "integer", "minimum": 1 },
        "stepsPerRequirement": { "type": "integer", "minimum": 1 }
      }
    },
    "settlement": {
      "type": "object",
      "additionalProperties": false,
      "required": ["requireEvents", "requireNoFailedSteps", "requireEnding", "requireInboxConsumed"],
      "properties": {
        "requireEvents": { "type": "boolean" },
        "requireNoFailedSteps": { "type": "boolean" },
        "requireEnding": { "type": "boolean" },
        "requireInboxConsumed": { "type": "boolean" }
      }
    },
    "harness": {
      "type": "object",
      "additionalProperties": false,
      "required": ["adapter"],
      "properties": {
        "adapter": { "type": "string", "enum": ["auto", "pi", "claude-code", "codex", "generic"] }
      }
    },
    "allowedTools": {
      "type": "array",
      "items": { "type": "string" }
    },
    "game": {
      "type": "object",
      "additionalProperties": false,
      "required": ["mountRoot", "reportPrefix"],
      "properties": {
        "mountRoot": { "type": "string", "pattern": "^/tmp/" },
        "reportPrefix": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
      }
    }
  }
}
