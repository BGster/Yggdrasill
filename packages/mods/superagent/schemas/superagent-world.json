{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://yggdrasill.dev/schemas/v1/superagent-world.json",
  "type": "object",
  "additionalProperties": false,
  "required": ["bureau", "seedText", "tuning", "npcs", "clerks", "items", "roles", "skills", "questTypes", "commissions", "copy"],
  "properties": {
    "bureau": { "type": "string", "minLength": 1 },
    "seedText": { "type": "string", "minLength": 1 },
    "tuning": {
      "type": "object",
      "additionalProperties": false,
      "required": ["dayStep", "askPatienceCost", "deadlineGraceDays"],
      "properties": {
        "dayStep": { "type": "integer", "minimum": 1 },
        "askPatienceCost": { "type": "integer", "minimum": 1 },
        "deadlineGraceDays": { "type": "integer", "minimum": 0 }
      }
    },
    "npcs": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "title", "kind", "patience", "briefing"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["client", "clerk"] },
          "patience": { "type": "integer", "minimum": 0 },
          "briefing": { "type": "string", "minLength": 1 }
        }
      }
    },
    "clerks": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "title", "kind"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "title": { "type": "string", "minLength": 1 },
          "kind": { "type": "string", "enum": ["clerk"] }
        }
      }
    },
    "items": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "name", "category", "weight", "holder"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "name": { "type": "string", "minLength": 1 },
          "category": { "type": "string", "enum": ["tool", "doc"] },
          "weight": { "type": "integer", "minimum": 1 },
          "holder": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    },
    "roles": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "spec"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
          "spec": { "type": "object", "required": ["attrs_spec"] }
        }
      }
    },
    "skills": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "spec"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9_.-]*$" },
          "spec": { "type": "object", "required": ["attrs_spec"] }
        }
      }
    },
    "questTypes": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["name", "steps", "deadlineDays"],
        "properties": {
          "name": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "steps": {
            "type": "array",
            "minItems": 1,
            "items": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
          },
          "deadlineDays": { "type": "integer", "minimum": 1 }
        }
      }
    },
    "commissions": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["key", "type", "giver", "title", "rewardSkill"],
        "properties": {
          "key": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "type": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "giver": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
          "title": { "type": "string", "minLength": 1 },
          "rewardSkill": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" }
        }
      }
    },
    "copy": {
      "type": "object",
      "required": ["prologue", "boardPrompt", "askLine", "askDown", "closeEnding", "noCommission", "takeOk", "deliverOk"],
      "additionalProperties": false,
      "properties": {
        "prologue": {
          "type": "array",
          "minItems": 1,
          "items": { "type": "string", "minLength": 1 }
        },
        "boardPrompt": { "type": "string", "minLength": 1 },
        "askLine": { "type": "string", "minLength": 1 },
        "askDown": { "type": "string", "minLength": 1 },
        "closeEnding": { "type": "string", "minLength": 1 },
        "noCommission": { "type": "string", "minLength": 1 },
        "takeOk": { "type": "string", "minLength": 1 },
        "deliverOk": { "type": "string", "minLength": 1 }
      }
    }
  }
}
