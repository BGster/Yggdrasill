{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "shapez v1 world data",
  "type": "object",
  "required": ["schemaVersion", "tuning", "levels", "patches"],
  "additionalProperties": false,
  "properties": {
    "schemaVersion": { "const": 1 },
    "tuning": {
      "type": "object",
      "required": [
        "ticksPerSecond",
        "beltSpeedMilli",
        "itemSpacingMilli",
        "minerSpeedMilli",
        "processorCycle",
        "anchorEveryTicks"
      ],
      "additionalProperties": false,
      "properties": {
        "ticksPerSecond": { "type": "integer", "minimum": 1 },
        "beltSpeedMilli": { "type": "integer", "minimum": 1 },
        "itemSpacingMilli": { "type": "integer", "minimum": 1 },
        "minerSpeedMilli": { "type": "integer", "minimum": 1 },
        "processorCycle": {
          "type": "object",
          "required": ["cutter", "stacker", "rotater", "trash"],
          "additionalProperties": false,
          "properties": {
            "cutter": { "type": "integer", "minimum": 0 },
            "stacker": { "type": "integer", "minimum": 0 },
            "rotater": { "type": "integer", "minimum": 0 },
            "trash": { "type": "integer", "minimum": 0 }
          }
        },
        "anchorEveryTicks": { "type": "integer", "minimum": 1 }
      }
    },
    "levels": {
      "type": "array",
      "minItems": 1,
      "items": {
        "type": "object",
        "required": ["level", "shape", "required", "reward"],
        "additionalProperties": false,
        "properties": {
          "level": { "type": "integer", "minimum": 1 },
          "shape": { "type": "string", "pattern": "^(-|[RC SW][rgbypwu-]){4}(:(-|[RCSW][rgbypwu-]){4}){0,3}$" },
          "required": { "type": "integer", "minimum": 1 },
          "reward": { "type": "string" }
        }
      }
    },
    "patches": {
      "type": "array",
      "items": {
        "type": "object",
        "required": ["x", "y", "radius", "subshape", "color"],
        "additionalProperties": false,
        "properties": {
          "x": { "type": "integer" },
          "y": { "type": "integer" },
          "radius": { "type": "integer", "minimum": 1 },
          "subshape": { "enum": ["C", "R", "S", "W"] },
          "color": { "enum": ["r", "g", "b", "y", "p", "w", "u"] }
        }
      }
    }
  }
}
