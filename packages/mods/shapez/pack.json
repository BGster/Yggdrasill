    { "id": "codec", "version": "0.1.0" },
    { "id": "procgen", "version": "0.1.0" },
    { "id": "quest", "version": "0.1.0" }
  ],
  "code": {
    "entry": "mod.lua",
    "modules": [
      "src/shapes.lua",
      "src/belts.lua",
      "src/processors.lua",
      "src/hub.lua",
      "src/simtick.lua",
      "src/mapgen.lua",
      "src/savegame.lua"
    ]
